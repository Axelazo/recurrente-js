{
  "compilerOptions": {
    "declaration": true,
    "declarationDir": "./dist",
    "target": "es2016",
    "module": "commonjs",
    "outDir": "./dist",       // <-- This is correct
    "rootDir": "./src",      // <-- THIS IS THE FIX. ADD THIS LINE.
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "exclude": ["**/*.test.ts", "**/*.spec.ts", "**/__tests__/**/*"]
}